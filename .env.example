# Copier vers .env puis renseigner les valeurs. Ne JAMAIS commiter .env.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=xrag
POSTGRES_USER=xrag
POSTGRES_PASSWORD=change-me

# --- Ollama ---
# TROIS modes, au choix, sans éditer docker-compose.yml :
#
# 1. Docker (défaut portable, CPU) — Ollama tourne en conteneur.
#      OLLAMA_BASE_URL=            (vide => http://ollama:11434)
#      COMPOSE_PROFILES=ollama-docker
#
# 2. Ollama NATIF sur l'hôte (recommandé si GPU) — Mac Apple Silicon (Metal) ou
#    Windows natif. Bien plus rapide que le conteneur (CPU). Lancer Ollama sur l'hôte
#    (écoute 0.0.0.0:11434 : OLLAMA_HOST=0.0.0.0 puis relancer Ollama), puis :
#      OLLAMA_BASE_URL=http://host.docker.internal:11434
#      COMPOSE_PROFILES=              (ne PAS activer ollama-docker)
#
# 3. Ollama dans WSL (Windows + Docker Desktop backend WSL2) — Ollama installé dans la
#    distro WSL, lancé avec « OLLAMA_HOST=0.0.0.0 ollama serve ». Vu depuis le conteneur,
#    c'est aussi l'hôte, donc MÊMES valeurs que le mode natif :
#      OLLAMA_BASE_URL=http://host.docker.internal:11434
#      COMPOSE_PROFILES=
#
# Natif Windows (2) et WSL (3) partagent ce .env : permuter = arrêter l'un, lancer l'autre
# (un seul port 11434 à la fois). Procédure détaillée dans RUNBOOK.md (§4).
# host.docker.internal est résolu par extra_hosts (host-gateway) dans docker-compose.yml.
OLLAMA_BASE_URL=
# Profils Compose actifs (séparés par des virgules) : « ollama-docker » (Ollama en conteneur),
# « ui » (Open WebUI sur :3000). Ex. Docker complet : COMPOSE_PROFILES=ollama-docker,ui
COMPOSE_PROFILES=ollama-docker
# Garder le modèle chargé en mémoire (recommandé pour le warm-up 07:30)
OLLAMA_KEEP_ALIVE=24h
# Machine contrainte en RAM : KV cache quantifié (num-ctx 8192 => ~3,5 Go en f16,
# ~1 Go en q8_0, qualité quasi intacte). À exporter côté SERVEUR Ollama (conteneur :
# ajouter la variable au service ollama ; natif : environnement du démon).
# OLLAMA_KV_CACHE_TYPE=q8_0

# --- Sources (tokens API, jamais dans team-config.yml) ---
# GitLab — deux secrets pour deux sens de communication, ne PAS réutiliser l'un pour l'autre :
# - GITLAB_TOKEN (sortant) : PAT présenté PAR l'application À GitLab pour indexer
#   dépôts et MRs (scopes read_api + read_repository suffisent).
# - GITLAB_WEBHOOK_TOKEN (entrant) : secret que VOUS choisissez (openssl rand -hex 24)
#   pour la mise à jour temps réel — GitLab le renvoie dans chaque appel de webhook
#   (POST /api/webhooks/gitlab, header X-Gitlab-Token) et l'application le vérifie.
#   Renseigner la même valeur dans GitLab (groupe > Settings > Webhooks > Secret token).
#   Vide = webhook accepté SANS authentification. Procédure : RUNBOOK.md §8.
GITLAB_TOKEN=
GITLAB_WEBHOOK_TOKEN=

# Confluence et Jira : cinq modes d'authentification, résolus dans CET ordre selon les
# variables renseignées ci-dessous (première applicable retenue). Ne renseigner qu'UN mode.
#
# 1. cookie  — *_COOKIE : chaîne Cookie brute d'une session navigateur authentifiée
#              (DevTools > Application > Cookies). Dev/validation, expire avec la session.
#              SEUL mode possible pour du self-hosted (Server/Data Center) sans API token.
#              Copier TOUS les cookies du domaine (y compris SSO/ingress). Astuce Jira :
#              seraph.rememberme.cookie prolonge la validité (~2 semaines).
#              Ex. : CONFLUENCE_COOKIE=confluence_cookie=...; JSESSIONID=...
#                    JIRA_COOKIE=INGRESSCOOKIE=...; JSESSIONID=...; seraph.rememberme.cookie=...
# 2. oauth   — *_OAUTH_CLIENT_ID + *_OAUTH_CLIENT_SECRET : OAuth 2.0 « client credentials »
#              d'un compte de service Atlassian Cloud. RECOMMANDÉ en production : aucune
#              interaction humaine, access token rafraîchi automatiquement (~60 min), appels
#              routés par api.atlassian.com. Créer l'identifiant : admin.atlassian.com >
#              Paramètres > Comptes de service > (compte) > API OAuth 2.0.
# 3. basic   — *_USER + *_TOKEN : compte de service Data Center (login + mot de passe) ou
#              API token CLASSIQUE Atlassian Cloud (email + token). Domaine direct.
# 4. scoped  — *_TOKEN seul sur un site Cloud (*.atlassian.net) : API token d'un compte de
#              service. Appels routés par api.atlassian.com. Le token doit porter les scopes
#              read Confluence ET Jira, sinon 403 sur le produit manquant. NB : laisser
#              *_USER VIDE (l'email du compte de service ne sert pas à l'auth d'un token scoped).
# 5. bearer  — *_TOKEN seul sur du self-hosted : PAT Data Center. Domaine direct.
#
# cloudId (modes oauth/scoped) : découvert automatiquement via {site}/_edge/tenant_info.
CONFLUENCE_TOKEN=
CONFLUENCE_USER=
CONFLUENCE_COOKIE=
CONFLUENCE_OAUTH_CLIENT_ID=
CONFLUENCE_OAUTH_CLIENT_SECRET=
JIRA_TOKEN=
JIRA_USER=
JIRA_COOKIE=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=

# --- LLM distant (uniquement si llm.provider != ollama et politique de confidentialité OK) ---
GEMINI_PROJECT_ID=
GEMINI_LOCATION=europe-west1

# --- Proxy/miroir d'entreprise (build Docker uniquement) ---
# Si `docker compose build` échoue avec « Network is unreachable » sur Maven Central,
# le conteneur de build n'a pas d'accès internet direct. Remèdes, du plus simple au
# plus manuel :
# 1. Vous avez déjà un settings.xml qui fait marcher Maven (miroir Nexus/Artifactory
#    + token) : réutilisez-le tel quel. Copie unique depuis Windows :
#      mkdir -p ~/.m2 && cp /mnt/c/Users/<vous>/.m2/settings.xml ~/.m2/settings.xml
#    puis :  MAVEN_SETTINGS=/home/<vous>/.m2/settings.xml
#    (injecté en secret BuildKit : jamais copié dans l'image, jamais commité)
# 2. WSL a l'accès réseau (curl -sI https://repo.maven.apache.org/maven2/ répond)
#    mais pas le conteneur de build :  BUILD_NETWORK=host
# 3. Tout passe par un proxy déclaré (hôte/port : « netsh winhttp show proxy ») :
#    MAVEN_OPTS=-Dhttps.proxyHost=proxy.example.com -Dhttps.proxyPort=3128 -Dhttp.proxyHost=proxy.example.com -Dhttp.proxyPort=3128
MAVEN_SETTINGS=
BUILD_NETWORK=
MAVEN_OPTS=
# Téléchargement des modèles (ollama pull -> registry.ollama.ai) : en cas de
# « i/o timeout », déclarer le proxy — Ollama honore ces variables, contrairement
# à la JVM. Même hôte/port que dans votre settings.xml Maven ou
# « netsh winhttp show proxy ». Appliquer : docker compose up -d ollama
# PROXY_URL=http://proxy.example.com:3128
PROXY_URL=
# Exclusions du proxy (domaines internes). ATTENTION à la syntaxe : clients Go
# (Ollama) -> point initial « .nomEntreprise.fr », PAS « *.nomEntreprise.fr ».
# Toujours garder localhost,127.0.0.1 en tête.
# IMPORTANT : toujours inclure 0.0.0.0 — le CLI « ollama pull » appelle le serveur
# local via OLLAMA_HOST=0.0.0.0 ; sans cette exclusion, cet appel interne part
# vers le proxy et le pull échoue sans log serveur.
# NO_PROXY_URL=localhost,127.0.0.1,0.0.0.0,.nomEntreprise.fr
NO_PROXY_URL=
# Proxy avec interception TLS (logs ollama : « x509: certificate signed by unknown
# authority ») : certificat RACINE de l'entreprise au format PEM/Base64.
# Export depuis Windows : certmgr.msc > Autorités de certification racines de
# confiance > <CA de l'entreprise> > Exporter > X.509 encodé en Base64 (.cer),
# copier le fichier vers WSL puis pointer son chemin ici.
# Appliquer : docker compose up -d ollama
# CORPORATE_CA=/home/<vous>/certs/entreprise-root-ca.pem
CORPORATE_CA=

# --- Application ---
# Secret des endpoints d'administration MUTANTS (POST /api/admin/** : sync full,
# nightly, enrich) — attendu dans le header X-Admin-Token. Vide = accès libre
# (développement seul) : l'API est publiée sur le LAN, un POST sync?full=true
# re-embedde tout le corpus (heures de CPU). Générer : openssl rand -hex 24
ADMIN_TOKEN=
# Chemin du fichier de configuration d'équipe
TEAM_CONFIG=./team-config.yml
# Image rag-api à déployer. Laisser vide pour un build local (développement).
# Équipes : pointer l'image versionnée du registry, ex. :
#   RAG_API_IMAGE=ghcr.io/fatahbenguenna/x-rag-project-assistant:1.0.0
RAG_API_IMAGE=

# --- Notifications (batch nocturne, smoke tests) ---
# Webhook entrant compatible Slack/Mattermost/Rocket.Chat ({"text": "..."}).
# Vide = notifications dans les logs uniquement.
NOTIFY_WEBHOOK_URL=
