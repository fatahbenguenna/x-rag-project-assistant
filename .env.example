# Copier vers .env puis renseigner les valeurs. Ne JAMAIS commiter .env.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=xrag
POSTGRES_USER=xrag
POSTGRES_PASSWORD=change-me

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
# Garder le modèle chargé en mémoire (recommandé pour le warm-up 07:30)
OLLAMA_KEEP_ALIVE=24h

# --- Sources (tokens API, jamais dans team-config.yml) ---
# GitLab : PAT (scopes read_api + read_repository suffisent pour indexer).
GITLAB_TOKEN=

# Confluence et Jira : trois modes d'authentification, prioritaires dans cet ordre.
# 1. cookie  — *_COOKIE défini : chaîne Cookie brute copiée d'une session navigateur
#              authentifiée (DevTools > Application > Cookies). Mode dev/validation :
#              expire avec la session (le health check du batch signalera l'expiration).
#              Copier TOUS les cookies du domaine (y compris ceux du front SSO/ingress).
#              Astuce Jira : inclure seraph.rememberme.cookie prolonge la validité
#              (~2 semaines) — Seraph ré-authentifie même quand JSESSIONID expire.
#              Ex. : CONFLUENCE_COOKIE=confluence_cookie=...; JSESSIONID=...
#                    JIRA_COOKIE=INGRESSCOOKIE=...; JSESSIONID=...; seraph.rememberme.cookie=...
# 2. basic   — *_USER défini : compte de service Data Center (login + mot de passe
#              dans *_TOKEN) ou Atlassian Cloud (email + API token dans *_TOKEN).
# 3. bearer  — défaut : *_TOKEN seul = PAT Data Center.
CONFLUENCE_TOKEN=
CONFLUENCE_USER=
CONFLUENCE_COOKIE=
JIRA_TOKEN=
JIRA_USER=
JIRA_COOKIE=

# --- LLM distant (uniquement si llm.provider != ollama et politique de confidentialité OK) ---
GEMINI_PROJECT_ID=
GEMINI_LOCATION=europe-west1
OPENAI_COMPATIBLE_API_KEY=

# --- Proxy d'entreprise (build Docker uniquement) ---
# Si `docker compose build` échoue avec « Network is unreachable » sur Maven Central :
# le conteneur de build n'a pas d'accès internet direct. Deux remèdes, à tester dans
# cet ordre (diagnostic : curl -sI https://repo.maven.apache.org/maven2/ depuis WSL) :
# 1. Le curl WSL répond -> le build doit utiliser le réseau de l'hôte :
#    BUILD_NETWORK=host
# 2. Le curl WSL échoue aussi -> tout passe par le proxy ; le déclarer à Maven
#    (hôte/port : PowerShell « netsh winhttp show proxy » ou paramètres proxy Windows) :
#    MAVEN_OPTS=-Dhttps.proxyHost=proxy.example.com -Dhttps.proxyPort=3128 -Dhttp.proxyHost=proxy.example.com -Dhttp.proxyPort=3128
BUILD_NETWORK=
MAVEN_OPTS=

# --- Application ---
# Chemin du fichier de configuration d'équipe
TEAM_CONFIG=./team-config.yml
# Image rag-api à déployer. Laisser vide pour un build local (développement).
# Équipes : pointer l'image versionnée du registry, ex. :
#   RAG_API_IMAGE=ghcr.io/fatahbenguenna/x-rag-project-assistant:1.0.0
RAG_API_IMAGE=

# --- Notifications (batch nocturne, smoke tests) ---
# Webhook entrant compatible Slack/Mattermost/Rocket.Chat ({"text": "..."}).
# Vide = notifications dans les logs uniquement.
NOTIFY_WEBHOOK_URL=
