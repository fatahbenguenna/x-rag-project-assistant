# Copier vers .env puis renseigner. Les secrets vivent ICI, jamais dans team-config.yml.

# --- PostgreSQL ---
POSTGRES_DB=xrag
POSTGRES_USER=xrag
POSTGRES_PASSWORD=change-me

# --- Tokens des sources (PAT en lecture seule) ---
CONFLUENCE_TOKEN=
GITLAB_TOKEN=
JIRA_TOKEN=

# --- LLM ---
# Profil Spring actif : ollama (local, confidentiel) ou gemini (si politique de confidentialité OK)
SPRING_PROFILES_ACTIVE=ollama
OLLAMA_KEEP_ALIVE=24h
# Requis uniquement avec le profil gemini
GEMINI_PROJECT_ID=

# --- Ports exposés ---
RAG_API_PORT=8080
OPEN_WEBUI_PORT=3000
